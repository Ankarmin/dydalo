{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      // SOLO para el seed (`prisma/`): importa el seed del frontend como
      // fuente única (`@/config/products`, `@/lib/stores/data-store.config`).
      // `src/` NUNCA importa `@/` (nest build no resuelve alias en runtime).
      "@/*": ["../web/src/*"]
    },
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  }
}
