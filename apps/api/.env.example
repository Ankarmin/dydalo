# DYDALO API — ejemplo de variables de entorno (Fase 1 backend).
# Copiar a .env (gitignored, nunca commitear secretos reales).
# Los valores POSTGRES_* deben coincidir con docker-compose.yml (o sus defaults).

# Prisma / Postgres (Fase 2 lo consumirá)
DATABASE_URL="postgresql://dydalo:dydalo@localhost:5432/dydalo?schema=public"

# API NestJS
NODE_ENV=development
PORT=3001

# Web pública (CORS + back_urls MP). FRONTEND_URLS admite coma-separado.
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=
# URL pública de esta API (notification_url del webhook MP).
# En local MP no la alcanza: usar el simulador admin.
API_PUBLIC_URL=http://localhost:3001

# Postgres del compose (defaults si no hay .env en raíz)
POSTGRES_DB=dydalo
POSTGRES_USER=dydalo
POSTGRES_PASSWORD=dydalo

# Auth (cookies httpOnly + JWT)
JWT_SECRET=change-me-in-local-env
JWT_EXPIRES_IN=7d
# Solo seed local: password inicial de diego@/david@ en `prisma db seed`
ADMIN_SEED_PASSWORD=dydalo-local-dev

# MercadoPago real (Fase 7).
# - MP_SANDBOX=true → usa sandbox_init_point (las credenciales de prueba
#   también pueden venir como APP_USR-, el prefijo TEST- no basta).
# - MP_WEBHOOK_SECRET sale del panel de la app en MP (firma HMAC).
# Sin token: preferencia en modo mock y webhook/sync responden 503.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_SANDBOX=false
